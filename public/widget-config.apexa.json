{
  "widget": {
    "position": {
      "placement": "bottom-right",
      "offset": { "horizontal": 20, "vertical": 20 }
    },
    "dimensions": { "width": 380, "height": 520, "minHeight": 320, "maxWidth": 1200 },
    "behavior": { "initialState": "minimized", "autoExpand": false, "allowFullscreen": true },
    "terms": {
      "enabled": true,
      "title": "Terms and Conditions",
      "content": "APEXA IQ test terms...",
      "acceptButtonText": "Accept",
      "declineButtonText": "Decline"
    }
  },
  "branding": {
    "logo": {
      "url": "https://www.apexaiq.com/wp-content/uploads/2021/11/iQ-50x50.png",
      "height": 40,
      "width": 40
    },
    "toggleButtonIcon": {
      "url": "https://www.apexaiq.com/wp-content/uploads/2021/11/iQ-50x50.png",
      "height": 32,
      "width": 32
    },
    "toggleButton": {
      "backgroundColor": "#fff"
    },
    "theme": {
      "primaryColor": "#ffffff",
      "secondaryColor": "#ffffff",
      "fontFamily": "Inter, Arial, sans-serif",

      "backgroundColor": "#fff",
      "surfaceColor": "#fff",
      "borderColor": "#1f2937",
      "textColor": "#e5e7eb",
      "textSecondaryColor": "#94a3b8"
    },
    "icons": {
      "primary": "#000",
      "secondary": "#0f172a",
      "neutral": "#1f2937",
      "destructive": "#000",
      "toggle": "#0f172a"
    },
    "poweredBy": { "text": "Powered by APEXA IQ (test)", "visible": true },
    "customCSS": { "enabled": false, "path": "/custom-apexa.css" }
  },
  "security": {
    "authentication": { "maxRetries": 3 },
    "api": { "host": "http://127.0.0.1:8000", "version": "v1", "timeout": 300000 }
  },
  "features": {
    "fileUpload": { "enabled": true, "maxSize": 5, "allowedTypes": ["image/*", "application/pdf"] },
    "logging": { "console": false }
  }
}
