{
  "widget": {
    "position": {
      "placement": "bottom-right",
      "offset": {
        "horizontal": 20,
        "vertical": 20
      }
    },
    "dimensions": {
      "width": 350,
      "height": 500,
      "minHeight": 300,
      "maxWidth": 1200
    },
    "behavior": {
      "initialState": "minimized",
      "autoExpand": false,
      "allowFullscreen": true
    },
    "terms": {
      "enabled": true,
      "title": "Terms and Conditions",
      "content": "By using this chat service, you agree to the following terms:\n\n1. Your conversations may be recorded for quality assurance.\n2. Do not share sensitive personal information.\n3. This service is provided \"as is\" without warranties.\n4. We may terminate access for violations of these terms.\n5. AI responses should not be considered professional advice.\n\nBy accepting, you confirm that you understand and agree to these terms.",
      "acceptButtonText": "Accept",
      "declineButtonText": "Decline"
    }
  },
  "branding": {
    "logo": {
      "url": "data:image/png;base64,",
      "height": 40,
      "width": 40
    },
    "toggleButtonIcon": {
      "url": "data:image/png;base64,",
      "height": 32,
      "width": 32
    },
    "theme": {
      "primaryColor": "#FFFFFF",
      "secondaryColor": "#000",
      "fontFamily": "Arial"
    },
    "poweredBy": {
      "text": "Powered by lowtouch.ai",
      "visible": true
    },
    "customCSS": {
      "enabled": false,
      "path": "/custom.css"
    }
  },
  "security": {
    "authentication": {
      "maxRetries": 3
    },
    "api": {
      "host": "http://127.0.0.1:8000",
      "version": "v1",
      "timeout": 300000,
      "model": "ltaisite:0.3"
    }
  },
  "features": {
    "fileUpload": {
      "enabled": true,
      "maxSize": 2,
      "allowedTypes": ["image/*", "application/pdf"]
    }
  }
}
