{
  "widget": {
    "position": {
      "placement": "bottom-right",
      "offset": {
        "horizontal": 20,
        "vertical": 20
      }
    },
    "dimensions": {
      "width": 350,
      "height": 500,
      "minHeight": 300
    },
    "behavior": {
      "initialState": "minimized",
      "autoExpand": false
    }
  },
  "branding": {
    "logo": {
      "url": "https://demo2025a.lowtouch.ai/static/splash.png",
      "height": 40,
      "width": 40
    },
    "theme": {
      "primaryColor": "#FFFFFF",
      "secondaryColor": "#000",
      "fontFamily": "Arial"
    },
    "poweredBy": {
      "text": "Powered by lowtouch.ai",
      "visible": true
    },
    "customCSS": {
      "enabled": false,
      "path": "/custom.css"
    }
  },
  "security": {
    "authentication": {
      "tokenRefreshInterval": 3600,
      "maxRetries": 3
    },
    "rateLimit": {
      "requestsPerMinute": 60,
      "maxConcurrentUsers": 100
    },
    "api": {
      "endpoint": "http://127.0.0.1:8000/api/openai/v1/chat/completions",
      "version": "v1",
      "timeout": 300000
    }
  },
  "features": {
    "fileUpload": {
      "enabled": true,
      "maxSize": 2,
      "allowedTypes": ["image/*", "application/pdf"]
    },
    "logging": {
      "level": "error",
      "retention": 7
    },
    "performance": {
      "messageBuffer": 50,
      "streamingBufferSize": 1024
    }
  }
}
