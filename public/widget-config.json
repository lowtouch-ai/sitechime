{
  "widget": {
    "position": {
      "placement": "bottom-right",
      "offset": {
        "horizontal": 20,
        "vertical": 20
      }
    },
    "dimensions": {
      "width": 350,
      "height": 600,
      "minHeight": 300,
      "maxWidth": 1200
    },
    "zIndex": 9999,
    "behavior": {
      "initialState": "minimized",
      "autoExpand": false,
      "allowFullscreen": true,
      "clearChat": {
        "enabled": true
      }
    }
  },
  "branding": {
    "botName": "AI Assistant",
    "headerSubtitle": "Online Now",
    "logo": {
      "url": "https://www.apexaiq.com/wp-content/uploads/2021/11/iQ-50x50.png",
      "width": 32,
      "height": 32
    },
    "toggleButton": {
      "backgroundColor": "#000",
      "size": 60,
      "borderRadius": "50%"
    },
    "theme": {
      "primaryColor": "#0ea5e9",
      "secondaryColor": "#ffffff",
      "fontFamily": "Arial",
      "backgroundColor": "#ffffff",
      "borderColor": "#e5e7eb",
      "textColor": "#111827",
      "textSecondaryColor": "#71717a",
      "glassmorphism": {
        "opacity": 0.75,
        "blur": "12px",
        "messageOpacity": 1.0
      },
      "messageBorderRadius": "1.15rem"
    },
    "icons": {
      "destructive": "#ef4444"
    },
    "poweredBy": {
      "text": "Powered by lowtouch.ai",
      "visible": true
    },
    "customCSS": {
      "enabled": false,
      "path": "/custom.css"
    }
  },
  "security": {
    "authentication": {
      "maxRetries": 3
    },
    "api": {
      "host": "http://127.0.0.1:8000",
      "timeout": 300000,
      "model": "webshop:0.5"
    }
  },
  "features": {
    "fileUpload": {
      "enabled": true,
      "maxSize": 2,
      "allowedTypes": [
        "image/*",
        ".pdf",
        ".doc",
        ".docx",
        ".txt"
      ]
    },
    "logging": {
      "console": false
    }
  }
}
